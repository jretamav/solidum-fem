# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# LaTeX
*.aux
*.log
*.out
*.toc
*.idx
*.ilg
*.ind
*.synctex.gz

# Artefactos de salida de Solidum FEM (generados al ejecutar ejemplos)
*.vtu
*.pvd
*_text_export.txt

# Configuración local del IDE / Claude Code
# Excluye todo .claude/ excepto contenido que debe viajar con el repo
# (skills, agents y commands son herramientas del proyecto, no config local).
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/

# Referencias bibliográficas externas: NUNCA se redistribuyen desde este
# repositorio (público, LGPL-3.0) por derechos de autor de sus editores.
# La convención de docs/referencias/README.md es documentar cada fuente y
# dónde obtenerla, no incluir el PDF. Los archivos viven en disco para
# consulta local y quedan fuera de git deliberadamente.
docs/referencias/**/*.pdf
docs/referencias/*.pdf
